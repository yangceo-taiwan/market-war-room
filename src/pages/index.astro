---
import BaseLayout from "../layouts/BaseLayout.astro";
import MetricCard from "../components/MetricCard.astro";
import LampPill from "../components/LampPill.astro";
import { data, basePath } from "../lib/data";
import { directionText, formatTaipei } from "../lib/format";

const { market, viewpoints } = data;
const statusLabel = market.mode === "live" ? "即時資料模式" : market.mode === "partial" ? "部分來源降級" : "示範資料模式";
---
<BaseLayout title="市場觀點戰情室" description="公開市場資料、新聞與一般性觀點的一頁式戰情室。" active="home">
  <section class="hero shell">
    <div class="eyebrow">Public market intelligence · Private sharing</div>
    <h1 class="page-title">先看風險，<br />再看方向。</h1>
    <p class="lede">把分散的市場指標、公開觀點與風險訊號壓縮成一個可快速掃描的決策畫面。沒有持倉、沒有個資，也沒有個人化買賣建議。</p>
    <div class="hero-meta">
      <span class="pill"><span class="dot"></span>{statusLabel}</span>
      <span class="pill">台北時間 {formatTaipei(market.updatedAt)}</span>
      <a class="pill" href={basePath("/health/")}>查看來源健康狀態 →</a>
    </div>
    {market.mode === "sample" && <div class="warning" style="margin-top:18px">目前顯示的是專案內建示範資料，僅用於確認版面。執行資料更新後，成功取得的欄位會改為公開來源資料。</div>}
  </section>

  <section class="shell section" aria-labelledby="market-summary">
    <div class="section-head"><div><div class="eyebrow">Market pulse</div><h2 class="section-title" id="market-summary">今日市場脈搏</h2></div><span class="muted">資料時間以各卡片來源為準</span></div>
    <div class="summary-strip">
      <article class="panel summary-item temperature">
        <div class:list={["temperature-score", `lamp-${market.temperature.lamp}`]}>{market.temperature.score}</div>
        <div><span class="muted">市場溫度 / 100</span><h3 class="section-title">{market.temperature.label}</h3><LampPill lamp={market.temperature.lamp} /></div>
      </article>
      <article class="panel summary-item"><span class="muted">日線結構</span><h3 class="metric-value">{directionText[market.dailyTrend]}</h3><span class:list={["change", market.dailyTrend === "bull" ? "up" : market.dailyTrend === "bear" ? "down" : "flat"]}>Daily · {market.dailyTrend}</span></article>
      <article class="panel summary-item"><span class="muted">小時線結構</span><h3 class="metric-value">{directionText[market.hourlyTrend]}</h3><span class:list={["change", market.hourlyTrend === "bull" ? "up" : market.hourlyTrend === "bear" ? "down" : "flat"]}>Hourly · {market.hourlyTrend}</span></article>
    </div>
    <div class="metric-grid">{market.metrics.map((item) => <MetricCard item={item} />)}</div>
  </section>

  <section class="shell section">
    <div class="content-grid">
      <article class="panel content-card">
        <div class="eyebrow">Executive readout</div>
        <h2 class="section-title" style="font-size:1.55rem;margin-top:8px">今日綜合結論</h2>
        <p class="lede" style="font-size:1rem">{viewpoints.conclusion}</p>
        <a class="pill" href={basePath("/viewpoints/")} style="margin-top:12px">展開今日觀點 →</a>
      </article>
      <article class="panel content-card">
        <div class="eyebrow">Today's discipline</div>
        <h2 class="section-title" style="margin-top:8px">今日不做什麼</h2>
        <ul class="plain-list">{viewpoints.doNotDo.slice(0, 3).map((item) => <li>— {item}</li>)}</ul>
      </article>
    </div>
  </section>
</BaseLayout>
